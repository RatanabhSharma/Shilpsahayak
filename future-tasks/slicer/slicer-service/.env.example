# Shilp Studio Slicing Service — environment variables
# Copy to .env for local development. Never commit the real .env file.

# --- Server ---
# Render sets this automatically in production; only needed locally if you
# want to match Render's port instead of the uvicorn default.
PORT=8000

# Comma-separated list of allowed CORS origins for the frontend.
# Leave unset locally (falls back to "*"). In production, set this to your
# real frontend domain(s), e.g.:
# ALLOWED_ORIGINS=https://shilpsahayak.com,https://www.shilpsahayak.com
ALLOWED_ORIGINS=*

# --- Slicing engines (native CLI binaries, installed separately per-target) ---
# See README.md — these are NOT bundled in the Docker image. Without them,
# slicing jobs route to manual review instead of crashing.
PRUSASLICER_PATH=
BAMBUSTUDIO_PATH=

# --- Slicing behavior ---
MAX_CONCURRENT_SLICES=3
SLICER_TIMEOUT_SECONDS=600

# --- Cloudflare R2 upload worker (shilp-sahayak-r2) ---
# Local dev default is http://127.0.0.1:8787 (wrangler dev). In production,
# point this at your deployed Cloudflare Worker URL.
VITE_CLOUDFLARE_WORKER_URL=http://127.0.0.1:8787
