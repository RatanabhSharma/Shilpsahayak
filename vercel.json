{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    { "source": "/catalog", "destination": "/shop", "permanent": true },
    { "source": "/about", "destination": "/our-story", "permanent": true },
    { "source": "/contact", "destination": "/reach-us", "permanent": true },
    { "source": "/shilp-studio", "destination": "/shop", "permanent": false },
    { "source": "/custom-printing", "destination": "/shop", "permanent": false },
    { "source": "/custom-service", "destination": "/shop", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
